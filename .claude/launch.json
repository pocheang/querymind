{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "conda",
      "runtimeArgs": [
        "run",
        "-n",
        "rag-local",
        "--no-capture-output",
        "python",
        "-m",
        "uvicorn",
        "app.api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
