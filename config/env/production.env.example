APP_ENV=production
APP_WORKERS=2
QUOTA_ENABLED=true
MODEL_BACKEND=openai
OPENAI_API_KEY=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_TOKEN_TTL_HOURS=8
RETRIEVAL_CACHE_BACKEND=redis
QUERY_GUARD_BACKEND=redis
AUTO_INGEST_ENABLED=false
# Compare the index stores with each other every 6 hours and log drift (report-only).
INDEX_RECONCILE_INTERVAL_SECONDS=21600
CORS_ALLOW_ORIGINS=https://your-domain.example
NEO4J_PASSWORD=
